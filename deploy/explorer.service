[Unit]
Description=LBRY explorer Go frontend
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=explorer
Group=explorer
WorkingDirectory=/opt/lbry-explorer/current
EnvironmentFile=/etc/lbry-explorer/explorer.env
Environment=EXPLORER_LISTEN=127.0.0.1:8080
Environment=EXPLORER_CACHE_DIR=/var/cache/lbry-explorer/go
ExecStart=/opt/lbry-explorer/current/explorer
Restart=on-failure
RestartSec=3
TimeoutStopSec=15
CacheDirectory=lbry-explorer/go
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
