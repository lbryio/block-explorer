# Include in the explorer.lbry.com server block.
# Keep its TLS, intended cache headers and error handling.
# Proxy assets as well as pages: Go releases need no disk webroot.
# Adjust/remove any older static-file locations that take precedence over this.
location / {
    proxy_pass http://127.0.0.1:8080;
    proxy_set_header Host $http_host;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_read_timeout 300s;
}
